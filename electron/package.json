{
  "name": "livetrackui-electron",
  "version": "0.1.0",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "package:linux": "electron-builder --linux AppImage --x64"
  },
  "devDependencies": {
    "electron": "^36.2.1",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.livetrackui.display",
    "productName": "LiveTrackUI",
    "artifactName": "${productName}.${ext}",
    "linux": {
      "target": ["AppImage"]
    }
  }
}
